{
  "name": "@valence/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#dialect/*": {
      "mysql": "./src/db/mysql/*.ts",
      "default": "./src/db/postgres/*.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/Main.ts",
    "build": "tsc --build",
    "start": "node dist/Main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.mysql.json",
    "db:generate": "drizzle-kit generate --config drizzle.postgres.config.ts && drizzle-kit generate --config drizzle.mysql.config.ts",
    "db:generate:postgres": "drizzle-kit generate --config drizzle.postgres.config.ts",
    "db:generate:mysql": "drizzle-kit generate --config drizzle.mysql.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.postgres.config.ts",
    "db:migrate:postgres": "drizzle-kit migrate --config drizzle.postgres.config.ts",
    "db:migrate:mysql": "drizzle-kit migrate --config drizzle.mysql.config.ts",
    "db:push": "drizzle-kit push --config drizzle.postgres.config.ts",
    "db:push:postgres": "drizzle-kit push --config drizzle.postgres.config.ts",
    "db:push:mysql": "drizzle-kit push --config drizzle.mysql.config.ts",
    "bundle": "pnpm bundle:postgres && pnpm bundle:mysql && pnpm bundle:launch",
    "bundle:postgres": "esbuild --bundle --platform=node --format=esm --target=node22 --packages=external src/Main.ts src/Migrate.ts src/Rollback.ts --outdir=dist --entry-names=[name].postgres",
    "bundle:mysql": "esbuild --bundle --platform=node --format=esm --target=node22 --packages=external --conditions=mysql src/Main.ts src/Migrate.ts src/Rollback.ts --outdir=dist --entry-names=[name].mysql",
    "bundle:launch": "esbuild --bundle --platform=node --format=esm --target=node22 --packages=external src/Launch.ts --outfile=dist/Main.js && esbuild --bundle --platform=node --format=esm --target=node22 --packages=external src/Launch.ts --outfile=dist/Migrate.js && esbuild --bundle --platform=node --format=esm --target=node22 --packages=external src/Launch.ts --outfile=dist/Rollback.js",
    "dev:mysql": "tsx watch --conditions=mysql --env-file-if-exists=../../.env src/Main.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.4",
    "@better-auth/passkey": "^1.7.4",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.0",
    "@valence/contracts": "workspace:*",
    "@valence/core": "workspace:*",
    "@valence/database": "workspace:*",
    "@valence/i18n": "workspace:*",
    "@valence/plugin-sdk": "workspace:*",
    "better-auth": "^1.7.4",
    "bonjour-service": "^1.4.4",
    "cron-parser": "^5.10.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.7",
    "mupdf": "^1.28.1",
    "music-metadata": "^11.15.0",
    "mysql2": "^3.24.5",
    "node-unrar-js": "^2.0.2",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "quickjs-emscripten": "0.32.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.0",
    "undici": "^8.10.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@better-auth/utils": "0.4.2",
    "@electric-sql/pglite": "^0.5.8",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "vitest": "^4.1.11"
  }
}
