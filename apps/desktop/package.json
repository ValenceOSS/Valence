{
  "name": "@valence/desktop",
  "version": "0.0.0",
  "productName": "Valence",
  "description": "Valence, a self-hosted streaming platform, as a desktop app.",
  "author": {
    "name": "Valence"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "vite build",
    "decoders": "tsx src/build/buildTheDecoders.ts",
    "package": "tauri build --config src-tauri/tauri.local.conf.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "renderer": "vite",
    "update-manifest": "tsx src/build/writeUpdateManifest.ts",
    "sweep": "tsx src/build/sweepForLeaks.ts"
  },
  "dependencies": {
    "@keyline-icons/react": "1.8.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.36",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-notification": "2.8.0",
    "@valence/client": "workspace:*",
    "@valence/contracts": "workspace:*",
    "@valence/core": "workspace:*",
    "@valence/i18n": "workspace:*",
    "@valence/screens": "workspace:*",
    "@valence/ui": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
