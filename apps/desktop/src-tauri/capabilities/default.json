{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app's own pages, served from the loopback server, may ask of the app.",
  "windows": ["main", "update-*"],
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "notification:default",
    "allow-preferences-write",
    "allow-preferences-forget",
    "allow-this-launch-write",
    "allow-this-launch-forget",
    "allow-what-is-now",
    "allow-carried-storage-taken",
    "allow-go-to-the-server",
    "allow-change-server",
    "allow-frame-minimise",
    "allow-frame-maximise",
    "allow-frame-close",
    "allow-show-the-window-controls",
    "allow-keep-the-screen-on",
    "allow-held-all",
    "allow-held-keep",
    "allow-held-drop",
    "allow-held-pause",
    "allow-listening-fetch",
    "allow-listening-stop",
    "allow-listening-drop",
    "allow-listening-has",
    "allow-servers-reach",
    "allow-update-download",
    "allow-set-unread-badge",
    "allow-passkeys-ask",
    "allow-passkeys-make",
    "allow-passkeys-sign-in-on-a-page",
    "allow-passkeys-add-one-in-the-browser",
    "allow-now-watching",
    "allow-cast-now",
    "allow-cast-connect",
    "allow-cast-load",
    "allow-cast-play",
    "allow-cast-pause",
    "allow-cast-seek",
    "allow-cast-volume",
    "allow-cast-disconnect",
    "allow-cast-address-of",
    "allow-press-a-shortcut"
  ]
}
