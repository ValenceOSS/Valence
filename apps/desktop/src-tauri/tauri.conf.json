{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Valence",
  "version": "../package.json",
  "identifier": "app.valence.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "pnpm run renderer",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["../build/icon.png"] },
  "plugins": {
    "updater": { "pubkey": "", "endpoints": [] }
  }
}
