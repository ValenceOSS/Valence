{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Valence",
  "version": "../package.json",
  "identifier": "app.valence.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "pnpm run renderer",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "Valence contributors",
    "copyright": "Copyright © Valence contributors",
    "homepage": "https://getvalence.app",
    "category": "Video",
    "shortDescription": "Valence, a self-hosted streaming platform.",
    "longDescription": "Valence, a self-hosted streaming platform, as a desktop app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/ValenceOSS/Valence/releases/latest/download/latest.json"]
    }
  }
}
