{
  "name": "@valence/tv",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "prebuild": "EXPO_TV=1 REACT_NATIVE_NODE_MODULES_DIR=$PWD/node_modules expo prebuild --platform ios --clean",
    "tvos": "EXPO_TV=1 REACT_NATIVE_NODE_MODULES_DIR=$PWD/node_modules expo run:ios",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@keyline-icons/react-native": "^1.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-tvos/config-tv": "^0.1.6",
    "@tanstack/react-query": "^5.102.8",
    "@valence/client": "workspace:*",
    "@valence/contracts": "workspace:*",
    "@valence/core": "workspace:*",
    "expo": "~57.0.24",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-video": "~57.0.4",
    "react": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.3-0",
    "react-native-svg": "15.15.4",
    "uqr": "^0.1.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@types/xcode": "3.0.0",
    "babel-preset-expo": "^57.0.12",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  },
  "jest": {
    "preset": "jest-expo/ios",
    "transform": {
      "\\.[jt]sx?$": [
        "babel-jest",
        {
          "babelrc": false,
          "configFile": false,
          "presets": [
            "babel-preset-expo"
          ],
          "caller": {
            "name": "metro",
            "bundler": "metro",
            "platform": "ios"
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@ValenceTv/(.*)$": "<rootDir>/src/$1",
      "^@ValenceClient/(.*)$": "<rootDir>/../../packages/client/src/$1",
      "^@ValenceContracts/(.*)$": "<rootDir>/../../packages/contracts/src/$1",
      "^@ValenceCore/(.*)$": "<rootDir>/../../packages/core/src/$1"
    }
  }
}
