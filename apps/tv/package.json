{
  "name": "@valence/tv",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "prebuild": "EXPO_TV=1 REACT_NATIVE_NODE_MODULES_DIR=$PWD/node_modules expo prebuild --platform ios --clean",
    "prebuild:android": "EXPO_TV=1 REACT_NATIVE_NODE_MODULES_DIR=$PWD/node_modules expo prebuild --platform android --clean",
    "tvos": "EXPO_TV=1 REACT_NATIVE_NODE_MODULES_DIR=$PWD/node_modules expo run:ios",
    "android": "EXPO_TV=1 REACT_NATIVE_NODE_MODULES_DIR=$PWD/node_modules expo run:android",
    "build:web": "EXPO_TV=1 REACT_NATIVE_NODE_MODULES_DIR=$PWD/node_modules expo export --platform web --output-dir web-dist && esbuild 'web-dist/_expo/static/js/web/*.js' --target=chrome84 --outdir=web-dist/_expo/static/js/web --allow-overwrite --log-level=warning",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@keyline-icons/react-native": "1.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-tvos/config-tv": "0.1.6",
    "@tanstack/react-query": "5.102.8",
    "@valence/client": "workspace:*",
    "@valence/contracts": "workspace:*",
    "@valence/core": "workspace:*",
    "core-js": "3.50.0",
    "expo": "57.0.24",
    "expo-asset": "57.0.18",
    "expo-audio": "57.0.5",
    "expo-constants": "57.0.19",
    "expo-crypto": "57.0.3",
    "expo-image": "57.0.5",
    "expo-linear-gradient": "57.0.2",
    "expo-secure-store": "57.0.4",
    "expo-video": "57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.3-0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.3",
    "uqr": "0.1.3",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.18",
    "@types/xcode": "3.0.0",
    "babel-preset-expo": "57.0.12",
    "esbuild": "0.28.2",
    "jest": "30.5.2",
    "jest-expo": "57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "7.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  }
}
