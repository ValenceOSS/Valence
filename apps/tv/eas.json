{
  "cli": {
    "version": "24.10.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.21.0",
      "pnpm": "10.34.5",
      "env": {
        "EXPO_TV": "1"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true
    },
    "firetv": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "preview": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
