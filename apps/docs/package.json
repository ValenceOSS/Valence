{
  "name": "@valence/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "spec": "tsx --env-file-if-exists=../../.env ../server/src/writeOpenApiDocument.ts public/openapi.json",
    "build": "pnpm spec && tsc --build && vite build",
    "preview": "vite preview",
    "start": "serve dist -l ${PORT:-3000}",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@keyline-icons/react": "^1.0.0",
    "@scalar/api-reference-react": "^0.9.70",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-router": "^1.170.36",
    "@valence/ui": "workspace:*",
    "highlight.js": "^11.12.0",
    "motion": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "serve": "^14.2.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
