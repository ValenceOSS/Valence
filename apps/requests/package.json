{
  "name": "@valence/requests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/Main.ts",
    "build": "tsc --build",
    "start": "node dist/Main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "bundle": "esbuild src/Main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/Main.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@valence/contracts": "workspace:*",
    "@valence/core": "workspace:*",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "drizzle-orm": "^0.45.2",
    "entities": "^8.1.0",
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.13.7",
    "iconv-lite": "^0.7.3",
    "music-metadata": "^11.15.0",
    "pg": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "vitest": "^4.1.11"
  }
}
