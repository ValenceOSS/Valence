{
  "name": "valence",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:serial": "turbo run test --concurrency=1",
    "test:coverage": "turbo run test -- --coverage",
    "coverage": "pnpm test:coverage && pnpm --filter @valence/tools exec tsx coverageAverage/checkCoverageAverage.ts",
    "typecheck": "turbo run typecheck",
    "lint": "pnpm --filter @valence/tools build:oxlint && oxlint --deny-warnings && tsx tools/comments/checkComments.ts",
    "lint:fix": "pnpm --filter @valence/tools build:oxlint && oxlint --fix --deny-warnings && tsx tools/comments/checkComments.ts --fix",
    "branch:check": "tsx tools/branches/checkBranchName.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "rust:check": "cargo clippy --all-targets -- -D warnings && cargo fmt --check",
    "rust:test": "cargo test",
    "prepare": "husky && pnpm --filter @valence/tools build:oxlint",
    "fixtures:sync": "tsx tools/fixtures/syncFixtures.ts",
    "ffmpeg:sync": "tsx tools/ffmpeg/syncFfmpeg.ts",
    "brand:render": "tsx tools/brand/renderBrand.ts",
    "db:check": "tsx tools/drizzle/checkDrizzleSnapshot.ts",
    "i18n:write": "tsx tools/i18n/writeStrings.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "oxfmt": "^0.71.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,mdx,css,yaml,yml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.rs": [
      "rustfmt --edition 2021"
    ]
  }
}
