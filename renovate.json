{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The valence-ffmpeg build the image installs, which local development syncs from too, and the default the docs give for it",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/(^|/)apps/docs/src/content/reference/environment-variables\\.mdx$/"
      ],
      "matchStrings": [
        "ARG VALENCE_FFMPEG_VERSION=(?<currentValue>\\S+)",
        "\\| `VALENCE_FFMPEG_VERSION` \\| `(?<currentValue>[^`]+)`"
      ],
      "depNameTemplate": "ValenceOSS/Valence-FFMPEG",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)(\\.(?<revision>\\d+))?$"
    }
  ]
}
