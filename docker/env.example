# Settings for compose.yaml. Save this as .env in the same folder, fill in the
# four required lines, and run `docker compose up -d`. Compose refuses to start
# while any of the four is empty, and names the one that is.
#
# Every setting is described at
# https://docs.getvalence.app/reference/environment-variables

# Required.
#
# Two long random strings, one for each secret: `openssl rand -hex 32` makes
# one, so run it twice. Letters and digits only for the password, which goes
# into an address where a / or @ breaks it. BETTER_AUTH_SECRET seals sign-in,
# and changing it later signs everybody out. Keep both in a password manager.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# The address a browser reaches Valence at: https://valence.example.com behind
# a reverse proxy, or http://192.168.1.40:8420 on your own network.
PUBLIC_URL=
# The folder on this machine that holds your library, such as /mnt/tank/media.
MEDIA_PATH=

# Whether sign-in cookies are sent only over HTTPS. Leave it unset and setup
# asks. Set it and it wins at every start: true behind HTTPS, false when
# testing over plain HTTP, where a browser throws a secure cookie away.
# COOKIE_SECURE=

# Optional, shown with their defaults.
TZ=UTC
VALENCE_PORT=8420
MEDIA_JOBS=4
RENDER_GROUP_ID=44
CATALOGUE_API_KEY=
SMTP_URL=
SMTP_FROM=

# Optional: requesting. Start the stack with COMPOSE_PROFILES=requests to use
# these. REQUESTS_URL is http://requests:8421, and REQUESTS_SECRET is at least
# 32 characters: `openssl rand -hex 32`.
REQUESTS_URL=
REQUESTS_SECRET=
DOWNLOADS_PATH=./downloads
PUID=1000
PGID=1000

# Optional: lets the requests service ask the media service what a file it has
# just filed really is. All four lines together; TRANSCODER_SECRET is at least
# 32 characters, `openssl rand -hex 32`.
TRANSCODER_SECRET=
# VALENCE_TRANSCODER_ADDR=0.0.0.0:8422
# VALENCE_TRANSCODER_URL=http://127.0.0.1:8422
# REQUESTS_TRANSCODER_URL=http://valence:8422

# Optional: a VPN for your download client. Add vpn to COMPOSE_PROFILES to use
# these.
VPN_URL=
VPN_API_KEY=
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
VPN_SERVER_COUNTRIES=
